# Posivex LiveKit Voice Agent Environment Variables
# Copy to .env and fill in real secrets. Real .env must NEVER be committed.

# --- LiveKit Cloud (signaling, media and SIP are hosted by LiveKit) ---
# Project Settings -> Keys in the LiveKit Cloud dashboard.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- AI Provider API Keys ---
# Google Gemini (Primary conversational LLM)
GEMINI_API_KEY=your_gemini_api_key

# Deepgram (Primary English & Spanish STT)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs (TTS streaming voice engine)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# AssemblyAI (Optional fallback STT)
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key

# ElevenLabs Agent ID reference
AGENT_ID=agent_8401m61r9k8kffpvcjqxtkx3ams1

# --- Webhook Integration (Posivex-lead-gen) ---
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here
# Lead-gen's public URL (the /api/webhooks/elevenlabs path is added when missing)
LEAD_GEN_WEBHOOK_URL=https://xyz.thebestdevsolutions.space

# --- Lead-gen integration (see docs/RUNBOOK.md section 7) ---
# Key lead-gen sends as xi-api-key (its VOICE_API_KEY). Any long random value.
POSIVEX_API_KEY=generate_a_long_random_value
# Calling number shown to lead-gen
VOICE_PHONE_NUMBER_ID=phnum_posivex_trunk
VOICE_PHONE_NUMBER=
# Only when the agent runs on LiveKit Cloud and cannot reach Postgres:
# RESULTS_CALLBACK_URL=https://voice.example.com
# RESULTS_CALLBACK_SECRET=generate_a_long_random_value
# Call recording to an S3-compatible bucket (LiveKit egress); off by default
# RECORDING_ENABLED=true
# RECORDING_BUCKET=
# RECORDING_REGION=auto
# RECORDING_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# RECORDING_ACCESS_KEY=
# RECORDING_SECRET=

# --- Infrastructure & Persistence ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/voice_agent
REDIS_URL=redis://localhost:6379/0

# --- Telephony Configuration ---
# mock | console | livekit_sip
TELEPHONY_PROVIDER=livekit_sip
# Created on LiveKit Cloud with: uv run python scripts/setup_telnyx_trunk.py ...
SIP_OUTBOUND_TRUNK_ID=ST_placeholder
SIP_PHONE_NUMBER_ID=phnum_placeholder

