# Posivex LiveKit Voice Agent Environment Variables
# Copy to .env and fill in real secrets. Real .env must NEVER be committed.

# --- LiveKit Cloud / Server ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- AI Provider API Keys ---
# Google Gemini (Primary conversational LLM)
GEMINI_API_KEY=your_gemini_api_key

# Deepgram (Primary English & Spanish STT)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs (TTS streaming voice engine)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# AssemblyAI (Optional fallback STT)
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key

# ElevenLabs Agent ID reference
AGENT_ID=agent_8401m61r9k8kffpvcjqxtkx3ams1

# --- Webhook Integration (Posivex-lead-gen) ---
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here
LEAD_GEN_WEBHOOK_URL=http://localhost:3000/api/webhooks/elevenlabs

# --- Infrastructure & Persistence ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/voice_agent
REDIS_URL=redis://localhost:6379/0

# --- Telephony Configuration ---
TELEPHONY_PROVIDER=mock  # mock | console | sip
SIP_OUTBOUND_TRUNK_ID=ST_placeholder
SIP_PHONE_NUMBER_ID=phnum_placeholder
