# Posivex LiveKit Voice Agent: environment variables.
# Copy to .env and fill in real secrets. The real .env (and .env.prod) must NEVER be committed.
# Where each variable is read: the API on your server (.env), the agent on LiveKit Cloud (.env.prod, sent by
# scripts/deploy_agent.py). See docs/RUNBOOK.md.

# --- LiveKit Cloud (signaling, media and SIP are hosted by LiveKit) ---
# Project Settings -> Keys in the LiveKit Cloud dashboard. The Cloud agent gets these injected by LiveKit itself.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Name the API dispatches to and the worker registers as. Change only if you rename the Cloud agent.
# LIVEKIT_AGENT_NAME=posivex-agent

# --- AI provider API keys (the agent needs all three) ---
# Google Gemini (conversation LLM, greeting check, post-call outcome)
GEMINI_API_KEY=your_gemini_api_key
# Deepgram (speech to text)
DEEPGRAM_API_KEY=your_deepgram_api_key
# ElevenLabs (text to speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# --- Optional agent tuning (no rebuild needed; defaults are in config/defaults.yaml) ---
# LLM_DEFAULT_MODEL=gemini-3.5-flash
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# vad | stt-only | v1 | v1-mini
# TURN_DETECTOR_MODE=vad
# LOG_LEVEL=INFO

# --- Lead-gen integration (see docs/RUNBOOK.md section 7) ---
# Key lead-gen sends as xi-api-key (its VOICE_API_KEY). Any long random value.
POSIVEX_API_KEY=generate_a_long_random_value
# Calling number shown to lead-gen
VOICE_PHONE_NUMBER_ID=phnum_posivex_trunk
VOICE_PHONE_NUMBER=
# Lead-gen's public URL (the /api/webhooks/elevenlabs path is added when missing)
LEAD_GEN_WEBHOOK_URL=https://xyz.thebestdevsolutions.space
# Must equal VOICE_WEBHOOK_SECRET on lead-gen; the API refuses to start with the placeholder for a real URL.
ELEVENLABS_WEBHOOK_SECRET=your_webhook_secret_here
# The agent on LiveKit Cloud cannot reach Postgres, so it reports each finished call to the API over HTTPS.
# Both values are also required in .env.prod for scripts/deploy_agent.py.
RESULTS_CALLBACK_URL=https://voice.example.com
RESULTS_CALLBACK_SECRET=generate_a_long_random_value

# --- Call recording to an S3-compatible bucket (LiveKit egress); off by default ---
# RECORDING_ENABLED=true
# RECORDING_BUCKET=
# RECORDING_REGION=us-east-1
# Blank for AWS S3; set for R2, MinIO, Wasabi and similar (R2 uses RECORDING_REGION=auto)
# RECORDING_ENDPOINT=
# RECORDING_ACCESS_KEY=
# RECORDING_SECRET=
# RECORDING_PREFIX=recordings
# RECORDING_FORCE_PATH_STYLE=false

# --- Database (the API and the outbox worker) ---
# docker-compose reads these three to create Postgres and build DATABASE_URL for the containers.
# POSTGRES_USER=posivex
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=posivex_calls
# For running outside Docker (alembic, scripts):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/voice_agent

# --- Telephony (the API dials) ---
# mock | console | livekit_sip. The default is mock, which dials nobody: set livekit_sip on the server.
TELEPHONY_PROVIDER=livekit_sip
# Created on LiveKit Cloud with: uv run python scripts/setup_telnyx_trunk.py ...
SIP_OUTBOUND_TRUNK_ID=ST_placeholder

# --- Local development only ---
# Lets the agent start a session with no dispatch metadata (a placeholder number). Never set in production.
# ALLOW_DEFAULT_CALL_REQUEST=true
